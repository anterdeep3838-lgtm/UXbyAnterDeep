{
  "redirects": [
    {
      "source": "/]",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/%5D",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/%5d",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hq",
      "destination": "/hq/index.html"
    }
  ],
  "headers": [
    {
      "source": "/hq/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hq",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
